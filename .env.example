OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
# Exact registered callback URL; use http://localhost:8888/api/auth/callback locally
OSU_REDIRECT_URI=https://YOUR-SITE.netlify.app/api/auth/callback
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional Neon Free club community tracking. Backend only; never use VITE_ prefixes.
DATABASE_URL=
# Generate a stable 32+ character secret; keep the same value across deployments.
CLUB_TRACKING_SECRET=
